; Engine configuration file.
; Escape Gravity — release build
config_version=5

[application]

config/name="Escape Gravity"
config/icon="res://assets/ui/app_icon.png"
config/description="Gravity-lure space roguelike. No guns. Only gravity."
config/version="1.0.9"
config/copyright="Escape Gravity"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.015, 0.02, 0.045, 1)
boot_splash/show_image=false

[autoload]

Audio="*res://src/audio.gd"
Assets="*res://src/assets.gd"
Store="*res://src/store.gd"
Controls="*res://src/controls.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/energy_saving/keep_screen_on=true
window/size/resizable=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.015, 0.02, 0.045, 1)
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_2d=0
textures/vram_compression/import_etc2_astc=true

[audio]

driver/enable_input=false

[input_devices]

pointing/emulate_touch_from_mouse=false

[layer_names]

2d_physics/layer_1="world"
